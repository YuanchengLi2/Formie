{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.useformie.com" }],
      "destination": "https://useformie.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "dashboard.useformie.app" }],
      "destination": "/admin"
    }
  ]
}
